# ==============================================================================
# NEXMONEY — Production Environment Variables Template
# Architecture: React + Vite + Netlify + Supabase + AWS S3 + CloudFront CDN
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Client-Safe)
# ------------------------------------------------------------------------------
# Supabase Project Credentials (Used for Auth, User Session, and RLS queries)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Cloud Storage API Base URL (Defaults to relative /api/cloud for SPA proxy)
VITE_API_BASE_URL="/api/cloud"

# ------------------------------------------------------------------------------
# BACKEND & CLOUD COMPUTING CONFIGURATION (Server-Side / Netlify Functions Only)
# Never expose these keys in client bundles or Git repositories.
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# AWS Region & S3 Private File Storage Bucket
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="nexmoney-private-files"

# AWS IAM Credentials (Leave empty for IAM Instance Roles / ECS Task Roles)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# AWS_SESSION_TOKEN=""

# AWS CloudFront CDN Distribution
AWS_CLOUDFRONT_DISTRIBUTION_ID="E1A2B3C4D5E6F7"
AWS_CLOUDFRONT_DOMAIN="d12345678abcdef.cloudfront.net"

# Encryption Key Management (AWS KMS Key ID or 256-bit Hex Master Key)
AWS_KMS_KEY_ID="alias/nexmoney-file-encryption"
# ENCRYPTION_MASTER_KEY=""

# Full-stack Server Port (Defaults to 3000)
PORT="3000"
